# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.emcforyou.com

# Google Search Console verification (Settings > Ownership verification > HTML tag > content value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics & tag management (src/components/shared/Analytics.tsx) -----
# Architecture: Website events -> dataLayer -> GTM -> GA4 / Meta Pixel.
# Set NEXT_PUBLIC_GTM_ID and configure the GA4 + Meta Pixel tags *inside*
# the GTM container (using the two IDs below as reference values) — that is
# the preferred setup. GA4/Pixel below only load directly, on their own, as
# a fallback for whichever of the two GTM is NOT covering.

# Google Tag Manager container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Paste this into the GA4
# Configuration tag inside GTM; only loads directly here if NEXT_PUBLIC_GTM_ID is blank.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel ID. Paste this into the Meta Pixel tag
# inside GTM; only loads directly here if NEXT_PUBLIC_GTM_ID is blank.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta domain verification (Meta Business Manager > Brand Safety > Domains).
# Only needed for the HTML-tag verification method — if Meta instead gives
# you a DNS TXT record, add that at your domain registrar/DNS provider, not here.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# --- Meta Conversions API (server-side, NOT yet wired up) ------------------
# Structure/env slots only — no CAPI route exists in this codebase yet.
# Add one only once these are supplied; never expose them with a NEXT_PUBLIC_ prefix.
META_CONVERSIONS_API_ACCESS_TOKEN=
META_DATASET_ID=

# Contact form + chatbot enquiry email delivery — sent via Gmail SMTP
# (src/lib/mailer.ts). GMAIL_APP_PASSWORD is a Gmail *App Password*, not the
# account's login password — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled on the GMAIL_USER account). Mail is sent from GMAIL_USER to
# CONTACT_FORM_TO_EMAIL; until all three are set, submissions are validated
# and rate-limited as normal but the route reports a delivery failure rather
# than a false success.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_FORM_TO_EMAIL=

# Simple shared secret used to protect the /api/contact route from generic bot traffic (optional)
CONTACT_FORM_HONEYPOT_FIELD=company_website

# --- WhatsApp Cloud API (Meta) — server-side only --------------------------
# Powers src/lib/whatsapp.ts + src/app/api/whatsapp/send-template/route.ts,
# which can send the approved "emc_healthcare_services_intro" template for
# manual testing only. Nothing calls this automatically yet — not wired to
# the contact form, chat-enquiry form, or any UI. Never prefix any of these
# with NEXT_PUBLIC_ — they must never reach the browser.
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# Shared secret required in the `x-whatsapp-internal-secret` header to call
# /api/whatsapp/send-template (server-to-server only). If blank, that
# endpoint rejects every request with 401. Use a long random string.
WHATSAPP_INTERNAL_API_SECRET=

# VIDEO header media for the "emc_healthcare_services_intro" template. Not
# secrets, but set per environment. Use ONE of:
# - WHATSAPP_INTRO_VIDEO_URL: public https:// MP4 (H.264 video + AAC audio,
#   max 16 MB) that Meta can download — localhost URLs will not work.
# - WHATSAPP_INTRO_VIDEO_MEDIA_ID: ID from POST /{phone-number-id}/media;
#   expires after ~30 days, so it needs re-uploading.
# The URL wins if both are set. If neither is set, sending that template
# returns 503 instead of a request Meta would reject.
WHATSAPP_INTRO_VIDEO_URL=
WHATSAPP_INTRO_VIDEO_MEDIA_ID=

# Webhook (src/app/api/whatsapp/webhook/route.ts). VERIFY_TOKEN is any
# random string you choose — enter the same value in the Meta App dashboard
# when saving the callback URL. APP_SECRET (App Settings > Basic) enables
# X-Hub-Signature-256 verification of incoming events; set it in production,
# otherwise events are accepted unverified.
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_APP_SECRET=

# --- Supabase (EMC Inbox) — the dedicated EMC project ONLY -------------------
# Project Settings > API in the EMC Supabase dashboard. URL + anon key are
# public by design (all tables are protected by Row Level Security) and are
# used by the /admin staff sign-in. Do not reuse another project's values.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Service-role key BYPASSES Row Level Security. Server-only
# (src/lib/supabase/admin.ts) — never add a NEXT_PUBLIC_ prefix, never log it.
SUPABASE_SERVICE_ROLE_KEY=
