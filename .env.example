# Copy this file to .env.local and fill in real values. Never commit .env.local.

# Public site URL (used for canonical URLs, sitemap, Open Graph, JSON-LD)
NEXT_PUBLIC_SITE_URL=https://www.emcforyou.com

# Google Search Console verification (Settings > Ownership verification > HTML tag > content value)
NEXT_PUBLIC_GOOGLE_SITE_VERIFICATION=

# --- Analytics & tag management (src/components/shared/Analytics.tsx) -----
# Architecture: Website events -> dataLayer -> GTM -> GA4 / Meta Pixel.
# Set NEXT_PUBLIC_GTM_ID and configure the GA4 + Meta Pixel tags *inside*
# the GTM container (using the two IDs below as reference values) — that is
# the preferred setup. GA4/Pixel below only load directly, on their own, as
# a fallback for whichever of the two GTM is NOT covering.

# Google Tag Manager container ID (GTM-XXXXXXX)
NEXT_PUBLIC_GTM_ID=

# Google Analytics 4 Measurement ID (G-XXXXXXXXXX). Paste this into the GA4
# Configuration tag inside GTM; only loads directly here if NEXT_PUBLIC_GTM_ID is blank.
NEXT_PUBLIC_GA_MEASUREMENT_ID=

# Meta (Facebook/Instagram) Pixel ID. Paste this into the Meta Pixel tag
# inside GTM; only loads directly here if NEXT_PUBLIC_GTM_ID is blank.
NEXT_PUBLIC_META_PIXEL_ID=

# Meta domain verification (Meta Business Manager > Brand Safety > Domains).
# Only needed for the HTML-tag verification method — if Meta instead gives
# you a DNS TXT record, add that at your domain registrar/DNS provider, not here.
NEXT_PUBLIC_META_DOMAIN_VERIFICATION=

# --- Meta Conversions API (server-side, NOT yet wired up) ------------------
# Structure/env slots only — no CAPI route exists in this codebase yet.
# Add one only once these are supplied; never expose them with a NEXT_PUBLIC_ prefix.
META_CONVERSIONS_API_ACCESS_TOKEN=
META_DATASET_ID=

# Contact form + chatbot enquiry email delivery — sent via Gmail SMTP
# (src/lib/mailer.ts). GMAIL_APP_PASSWORD is a Gmail *App Password*, not the
# account's login password — generate one at
# https://myaccount.google.com/apppasswords (requires 2-Step Verification
# enabled on the GMAIL_USER account). Mail is sent from GMAIL_USER to
# CONTACT_FORM_TO_EMAIL; until all three are set, submissions are validated
# and rate-limited as normal but the route reports a delivery failure rather
# than a false success.
GMAIL_USER=
GMAIL_APP_PASSWORD=
CONTACT_FORM_TO_EMAIL=

# Simple shared secret used to protect the /api/contact route from generic bot traffic (optional)
CONTACT_FORM_HONEYPOT_FIELD=company_website
